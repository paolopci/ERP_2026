{
  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1433;Database=ErpDb;User Id=sa;Password=Your_password123;TrustServerCertificate=true;Encrypt=false"
  },
  "Jwt": {
    "Issuer": "erp-api",
    "Audience": "erp-web",
    "SigningKey": "CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_32+",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
